datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                 String   @id @default(cuid())
  nombre             String
  descripcion        String   @db.Text
  precioAmazon       Float
  linkAfiliado       String
  imagen             String
  categoria          String
  rating             Float    @default(0)
  resena             String   @db.Text
  especsTecnicos     String[]
  ventajas           String[]
  desventajas        String[]
  clicksRegistrados  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reviews            Review[]
  clicks             Click[]

  @@index([categoria])
  @@index([rating])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comentario String  @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
}

model Click {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  referer   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  titulo    String
  contenido String   @db.Text
  imagen    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}